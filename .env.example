# Configuration du serveur
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Clés API FedaPay
# FEDAPAY_ENV peut valoir 'sandbox' (tests) ou 'live' (production)
FEDAPAY_ENV=sandbox
FEDAPAY_PUBLIC_KEY=pk_sandbox_votre_cle_publique_ici
FEDAPAY_SECRET_KEY=sk_sandbox_votre_cle_secrete_ici

# Secret Webhook FedaPay (généré dans le dashboard FedaPay lors de l'ajout du webhook)
FEDAPAY_WEBHOOK_SECRET=votre_secret_webhook_ici

# Plafond d'appels sortants vers l'API FedaPay (fenêtre glissante d'1 heure).
# Filet de sécurité : empêche qu'un abus n'épuise le quota du compte FedaPay
# et ne bloque les encaissements légitimes. 0 = désactivé.
FEDAPAY_OUTGOING_QUOTA_PER_HOUR=600

# ---------------------------------------------------------------------------
# Moneroo (fournisseur de paiement alternatif, activable via PAYMENT_PROVIDER)
# ---------------------------------------------------------------------------
# Fournisseur de paiement actif : 'fedapay' (défaut) ou 'moneroo'
PAYMENT_PROVIDER=fedapay
# Clés API Moneroo (Dashboard → Developers)
MONEROO_PUBLIC_KEY=pk_votre_cle_publique_ici
MONEROO_SECRET_KEY=test_votre_cle_secrete_ici
# Secret de signature du webhook Moneroo (Dashboard → Developers → Webhooks)
MONEROO_WEBHOOK_SECRET=votre_secret_webhook_ici
# Plafond d'appels sortants vers l'API Moneroo (fenêtre glissante 1 h)
MONEROO_OUTGOING_QUOTA_PER_HOUR=600
# Environnement Moneroo (lu par le service ; l'URL d'API est identique en
# sandbox et en live, seule la clé change).
MONEROO_ENV=sandbox
# (optionnel) Restreindre les paiements à un pays ISO2, ex. BJ. Vide = toutes méthodes XOF.
MONEROO_RESTRICT_COUNTRY=

# Réconciliation automatique des transactions en attente.
# SECOND FILTRE OBLIGATOIRE après le webhook : la cagnotte n'avance que sur un
# statut 'approved' en base, obtenu soit par le webhook FedaPay, soit par la
# vérification de la page de confirmation. Si les deux ratent (notification
# perdue, onglet fermé, webhook mal configuré ou bloqué par le proxy), le
# paiement reste 'pending' indéfiniment alors qu'il est encaissé. Le 27/09/2026,
# 2 000 FCFA approuvés chez FedaPay n'étaient toujours pas affichés : ce service
# n'était appelé que par les tests, jamais en production.
#   RECONCILIATION_ENABLED=false         → désactiver (déconseillé)
#   RECONCILIATION_INTERVAL_MINUTES=10   → fréquence des cycles
#   RECONCILIATION_BATCH_SIZE=25         → transactions maxi par cycle
#   RECONCILIATION_MAX_AGE_HOURS=720     → au-delà, la transaction n'est plus
#                                          relancée chez FedaPay (30 jours)
# Chaque appel reste soumis au budget FEDAPAY_OUTGOING_QUOTA_PER_HOUR.
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MINUTES=10
RECONCILIATION_BATCH_SIZE=25
RECONCILIATION_MAX_AGE_HOURS=720

# ---------------------------------------------------------------------------
# Surveillance de la cagnotte (watchdog) et alertes
# ---------------------------------------------------------------------------
# Troisième filet de sécurité, après le webhook et la réconciliation : il
# détecte qu'un encaissement n'a pas été comptabilisé et prévient un humain.
# Le 2026-09-27, la cagnotte est restée bloquée à 0 malgré des paiements
# réellement encaissés, et AUCUNE alerte n'a été émise : rien ne surveillait le
# canal de notification. Ne pas désactiver.
WATCHDOG_ENABLED=true

# Webhook Discord pour les alertes (nécessaire : https://support.discord.com/hc/fr-fr/articles/228383668-Introduction-aux-Webhooks-Inarrivables-Webhooks-Incoming)
# Laisser vide = mode sec : les alertes ne partent QUE dans les logs du serveur
# (rechercher « [Alerte] »). L'URL est un secret : elle n'est jamais journalisée.
ALERT_DISCORD_WEBHOOK_URL=

# Seuils d'alerte
#   ALERT_PENDING_MINUTES=30        → un don « pending » depuis plus de 30 min
#                                     déclenche une alerte CRITIQUE : c'est la
#                                     signature d'un paiement encaissé non compté.
#   ALERT_WEBHOOK_SILENT_HOURS=2    → aucune notification FedaPay depuis 2 h
#                                     alors que des dons arrivent.
#   ALERT_RECONCILIATION_ERRORS=3   → N cycles de réconciliation ratés d'affilée
#                                     (FedaPay injoignable, filet de sécurité aveugle).
#   ALERT_WEBHOOK_REJECTED=3        → N notifications FedaPay rejetées pour
#                                     signature invalide en 2 h. SIGNATURE D'UN
#                                     SECRET QUI NE CORRESPOND PAS : chaque
#                                     point de terminaison FedaPay a son PROPRE
#                                     secret (différent entre test et live).
#                                     Le compteur ne se remet à zéro que sur une
#                                     notification VALIDE.
#   ALERT_COOLDOWN_MINUTES=360      → anti-spam : une même condition n'est
#                                     ré-annoncée qu'après 6 h.
ALERT_PENDING_MINUTES=30
ALERT_WEBHOOK_SILENT_HOURS=2
ALERT_RECONCILIATION_ERRORS=3
ALERT_WEBHOOK_REJECTED=3
ALERT_WEBHOOK_REJECTED_WINDOW_HOURS=2
ALERT_COOLDOWN_MINUTES=360

# ---------------------------------------------------------------------------
# Export CSV des souscriptions (page https://ton-domaine/export.html)
# ---------------------------------------------------------------------------
# Jeton d'accès au relevé COMPLET des dons (noms, téléphones, e-mails,
# messages) : 32 caractères minimum. Générer avec :
#   openssl rand -hex 24
# Sans cette variable, l'endpoint /api/admin/export.csv répond 503 : l'export
# est fermé par défaut, jamais ouvert par inadvertance.
FECAWAY_EXPORT_TOKEN=

# Nombre de sauts de proxy de confiance dans la chaîne Cloudflare -> Traefik -> app.
# Aligne uniquement la validation d'express-rate-limit : la clé des rate-limits
# est calculée par server/services/client-ip.service.js, qui ne fait confiance
# qu'aux en-têtes AJOUTÉS par le proxy (et jamais à ceux préfixés par le client).
TRUSTED_PROXY_HOPS=2

# Pays par défaut (code ISO) quand le donateur saisit un numéro NATIONAL,
# sans indicatif pays. FedaPay exige un numéro national cohérent avec le pays
# déclaré : sans cela, un donateur ivoirin entrant « +225 07 … » était rejeté
# avec un message opaque. server/services/phone.service.js déduit le pays dès
# qu'un indicatif est saisi (BJ, CI, SN, ML, BF, TG, GM — toute la zone XOF).
FEDAPAY_PHONE_COUNTRY=BJ

# Plages IP Cloudflare : SOURCE UNIQUE DE VÉRITÉ, à ne pas dupliquer ailleurs.
# Alimente le middleware Traefik `ipwhitelist` (compose.yml), qui n'accepte que
# Cloudflare sur les routeurs de production, ET server/services/client-ip.service.js.
# Les deux listes doivent rester identiques : si elles divergeaient, le limiteur
# de l'application et celui du proxy s'autoriseraient mutuellement.
# RAFRAÎCHIR :
#   CLOUDFLARE_IP_RANGES="$(curl -s https://www.cloudflare.com/ips-v4 | paste -sd, -),$(curl -s https://www.cloudflare.com/ips-v6 | paste -sd, -)"
CLOUDFLARE_IP_RANGES=

# Secret du portail anti-accès direct (44 caractères aléatoires).
# Traefik l'écrase via le middleware 'fecawa-gate' (compose.yml) : l'application
# n'accepte que les requêtes passant par Traefik, ce qui bloque l'appel direct
# par les autres conteneurs du réseau Docker partagé 'proxy'.
# LAISSER VIDE en développement : le contrôle est alors désactivé.
#   openssl rand -base64 48 | tr -d '/+=' | head -c 44
FECAWAY_GATE_SECRET=

# Base de données
# Le fichier SQLite sera stocké par défaut dans data/fecawa.db
DB_FILE=data/fecawa.db

# Domaines (routeurs Traefik)
DOMAIN=example.com
ADMINER_DOMAIN=db.example.com
# Basic-auth du panneau Adminer : NE JAMAIS écrire le mot de passe en clair ici
# ni dans compose.yml (ces fichiers sont versionnés dans git). Seul le hash APR1
# est posé dans compose.yml, avec chaque '$' doublé en '$$'.
# Générer : H=$(openssl passwd -apr1 'motdepasse')

